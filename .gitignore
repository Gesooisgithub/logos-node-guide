# Never commit node identity or key material.
# These patterns exist because a single accidental commit is unrecoverable:
# anything pushed to a public repository must be considered permanently disclosed.

keystore.yaml
keystore*.yaml
user_config.yaml
user_config*.yaml
*.bak
state/
*.key
*.pem
id_rsa*
id_ed25519*
*.ppk

# Local notes and scratch files
notes/
scratch/
*.local.md

# Editor and OS noise
.DS_Store
Thumbs.db
.vscode/
.idea/
*~
*.swp
